	<queryString language="SQL">
		<![CDATA[SELECT
     revenue.`revenue_id` AS revenue_revenue_id,
     revenue.`date_enregistrement` AS revenue_date_enregistrement,
     revenue.`montant` AS revenue_montant,
     revenue.`matricule_pat` AS revenue_matricule_pat,
     revenue.`mode_paiement` AS revenue_mode_paiement,
     revenue.`statut_paiement` AS revenue_statut_paiement,
     revenue.`type_revenue` AS revenue_type_revenue,
     revenue.`source_revenue` AS revenue_source_revenue,
     revenue.`comptable_id` AS revenue_comptable_id
FROM
     `revenue` revenue]]>
	</queryString>
