	<queryString language="SQL">
		<![CDATA[SELECT
     patient.`matricule_pat` AS patient_matricule_pat,
     patient.`nom_pat` AS patient_nom_pat,
     patient.`prénom_pat` AS patient_prénom_pat,
     patient.`date_naissance` AS patient_date_naissance,
     patient.`maladie_pat` AS patient_maladie_pat,
     patient.`numTel` AS patient_numTel,
     patient.`adresse_pat` AS patient_adresse_pat,
     patient.`groupe_sanguin` AS patient_groupe_sanguin,
     patient.`sexe` AS patient_sexe,
     patient.`email` AS patient_email
FROM
     `patient` patient]]>
	</queryString>
