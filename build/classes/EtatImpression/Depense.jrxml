	<queryString language="SQL">
		<![CDATA[SELECT
     depense.`depense_id` AS depense_depense_id,
     depense.`date_enregistrement` AS depense_date_enregistrement,
     depense.`montant` AS depense_montant,
     depense.`fournisseur_id` AS depense_fournisseur_id,
     depense.`catégorie` AS depense_catégorie,
     depense.`num_facture` AS depense_num_facture,
     depense.`mode_paiement` AS depense_mode_paiement,
     depense.`comptable_id` AS depense_comptable_id,
     depense.`periodicité` AS depense_periodicité,
     depense.`description` AS depense_description
FROM
     `depense` depense]]>
	</queryString>
