	<queryString language="SQL">
		<![CDATA[Select ordonnance.* , medicament.*, utilisateurs.nom as nom ,patient.nom_pat,patient.prénom_pat,patient.date_naissance , medecin.specialite from ordonnance left join medicament on (medicament.ordonnance_id=ordonnance.ordonnance_id) left join patient on (patient.matricule_pat=ordonnance.matricule_pat) LEFT join medecin on (ordonnance.medecin_id=medecin.nom_utilisateur) left join utilisateurs on (medecin.nom_utilisateur=utilisateurs.nom_utilisateur)]]>
	</queryString>
