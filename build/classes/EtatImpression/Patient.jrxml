     patient.`antécédents_personnels` ,
     patient.`antécédents_familiaux` ,
     patient.`antécédents_médicaux` ,
     patient.`antécédents_chirurgicaux` ,
     patient.`groupe_sanguin` ,
     patient.`sexe` ,
     patient.`num_sécurité_social` ,
     patient.`email` ,
     patient.`note` ,
     patient.`situation_familiale` 
FROM
     `patient` patient]]>
