	<queryString language="SQL">
		<![CDATA[SELECT
     patient.`matricule_pat` ,
     patient.`nom_pat` ,
     patient.`prénom_pat` ,
     patient.`date_naissance` ,
     patient.`maladie_pat` ,
     patient.`numTel` ,
     patient.`numTelUrgence` ,
